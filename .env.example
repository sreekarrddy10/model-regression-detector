# .env.example — Canonical list of required environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env

# ─── LLM Providers ────────────────────────────────────────────────────────────
# At least one is required. The provider layer selects on MRD_MODEL's prefix.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Alerting ─────────────────────────────────────────────────────────────────
# Slack incoming webhook (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=

# ─── Model selection ──────────────────────────────────────────────────────────
# Feature under test — keep cheap; this runs N times per case.
MRD_MODEL="gpt-4o-mini"
# LLM-as-judge — keep strong; judge quality bounds eval quality.
MRD_JUDGE_MODEL="gpt-4o"

# ─── Run configuration ────────────────────────────────────────────────────────
# Repeats per case. 3 separates flaky flips from real regressions. Do not lower.
MRD_REPEATS="3"
# unit | smoke | full  (see docs/SPEC.md §3.5)
MRD_TIER="smoke"

# ─── Gate thresholds ──────────────────────────────────────────────────────────
# Accuracy delta that triggers a warning / blocks the merge.
MRD_WARN_THRESHOLD="0.03"
MRD_BLOCK_THRESHOLD="0.08"
# Minimum judge-vs-human agreement (Cohen's kappa) for judge scores to be trusted.
MRD_JUDGE_KAPPA_FLOOR="0.60"
# Slow-drift floor on the 7-run EWMA accuracy.
MRD_EWMA_FLOOR="0.90"

# ─── Storage ──────────────────────────────────────────────────────────────────
MRD_DB_PATH="./data/runs.sqlite"
